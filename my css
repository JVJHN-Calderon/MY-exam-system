*{box-sizing:border-box}
body{font-family:Arial,sans-serif;margin:0;background:#f4f6fa;color:#222}
header{background:#1e3a8a;color:#fff;padding:14px 20px}
h1{margin:0 0 10px;font-size:1.3rem}
nav{display:flex;gap:6px;flex-wrap:wrap}
.tab-btn{background:#3b5bdb;color:#fff;border:0;padding:8px 14px;border-radius:6px;cursor:pointer}
.tab-btn.active{background:#fff;color:#1e3a8a;font-weight:bold}
main{max-width:1100px;margin:16px auto;padding:0 16px}
.tab{display:none;background:#fff;padding:18px;border-radius:8px;box-shadow:0 1px 4px #0002}
.tab.active{display:block}
label{display:block;margin-bottom:12px;font-weight:bold;font-size:.9rem}
input,select{display:block;width:100%;padding:8px;margin-top:4px;border:1px solid #bbb;border-radius:5px;font-size:.95rem}
form{max-width:460px}
button[type=submit],.act{background:#1e3a8a;color:#fff;border:0;padding:9px 16px;border-radius:5px;cursor:pointer}
.act{padding:5px 9px;margin:2px;font-size:.8rem}.act.reject{background:#b91c1c}
#msg{display:none;max-width:1100px;margin:12px auto 0;padding:10px 14px;border-radius:6px}
#msg.ok{display:block;background:#dcfce7;color:#14532d}
#msg.err{display:block;background:#fee2e2;color:#7f1d1d}
.info{color:#1e3a8a;font-weight:bold;min-height:1.2em}
.filters{display:flex;gap:8px;flex-wrap:wrap;margin-bottom:12px}
.filters input,.filters select{flex:1;min-width:170px;margin:0}
.scroll{overflow-x:auto}
table{border-collapse:collapse;width:100%;font-size:.85rem}
th,td{border:1px solid #ddd;padding:6px 8px;text-align:left;vertical-align:top}
th{background:#e8edfb}
.badge{padding:2px 8px;border-radius:10px;background:#e5e7eb;font-size:.78rem;white-space:nowrap}
.badge.Submitted{background:#dbeafe}.badge.Processing{background:#fef3c7}
.badge.Ready{background:#dcfce7}
.badge.Claimed{background:#d1fae5}.badge.Rejected{background:#fee2e2}
.card{margin-top:14px;padding:14px;border:1px solid #ddd;border-radius:8px;max-width:460px}
.cols{display:flex;gap:24px;flex-wrap:wrap}.cols>div{flex:1;min-width:240px}